# Copy to .env and fill in. Never commit .env (it is in .gitignore).
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CLIENT_URL=http://localhost:5173

# MongoDB. memory:// = in-memory database, nothing to install (good for trying things out)
MONGODB_URI=memory://my_server
# MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=my_server

# Auth. Generate secrets with:  openssl rand -hex 32
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
COOKIE_SECRET=change-me-too

# Redis for the job queue. Empty = in-memory queue (jobs are lost on restart)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# SMTP. Empty SMTP_HOST = mails are only printed to the log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="My Server <no-reply@example.com>"

# Telegram bot (token from @BotFather). Empty = no bot.
# No TELEGRAM_WEBHOOK_URL = polling (good for development); with it = webhook (production, HTTPS)
TELEGRAM_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=change-me-telegram
TELEGRAM_ADMIN_CHAT_ID=
# TELEGRAM_API_URL=https://api.telegram.org   (your own Bot API server)

# Rate limit for /api (requests per 15 minutes per IP)
RATE_LIMIT=300
BEHIND_PROXY=false
